FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
LABEL org.opencontainers.image.source=https://github.com/spydersoft-consulting/email
LABEL org.opencontainers.image.description="Spydersoft Email API"
LABEL org.opencontainers.image.licenses=MIT

WORKDIR /app
COPY . /app

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

USER $APP_UID

ENTRYPOINT ["dotnet", "Spydersoft.EmailApi.dll"]
